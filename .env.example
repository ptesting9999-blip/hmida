# Copy to .env and fill in what you have. Only ANTHROPIC_API_KEY is required.

# Claude: intent classification, niche research, people extraction (required)
ANTHROPIC_API_KEY=

# Web search (pick one; without either, Claude's own web search tool is used)
BRAVE_API_KEY=
SERPER_API_KEY=

# Reddit "script" app credentials (https://www.reddit.com/prefs/apps) - higher rate limits
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Decision-maker emails and company email patterns (optional)
HUNTER_API_KEY=

# Email verification API (optional, recommended - required if your server can't use port 25)
ZEROBOUNCE_API_KEY=
NEVERBOUNCE_API_KEY=
MILLIONVERIFIER_API_KEY=
